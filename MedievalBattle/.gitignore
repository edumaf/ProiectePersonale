# --- Roblox / Rojo ---
# Built place files. The place is generated from source with `rojo build`,
# never committed - binary .rbxl files cannot be merged and will cause
# constant conflicts for a 4-person team.
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
*.rbxm
*.rbxmx

# Rojo/Studio scratch
sourcemap.json
*.rbxl.bak

# Local-only Rojo project overrides (e.g. a solo dev's test place mapping).
# Commit `default.project.json` only.
*.local.project.json

# --- Tooling ---
# Rokit install tree (optional toolchain manager, see rokit.toml)
.rokit/
.lune/
node_modules/

# The Rojo binary itself, if you drop it in this folder to avoid PATH setup.
# It is ~10MB and platform-specific - never commit it.
rojo
rojo.exe

# luau-lsp / editor
.vscode/settings.local.json
.idea/
*.log

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
