{
  "name": "MedievalBattle",
  "globIgnorePaths": ["**/.gitkeep", "**/*.md"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayerScripts"
      }
    },

    "StarterGui": {
      "$path": "src/StarterGui"
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -150
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 15,
        "Brightness": 2,
        "GlobalShadows": true,
        "GeographicLatitude": 45
      }
    }
  }
}
