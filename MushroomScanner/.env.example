# Copy to .env and fill in once you have a Supabase project (see
# supabase/README.md). Expo inlines EXPO_PUBLIC_* vars into the JS bundle
# at build time - restart `expo start` after changing these.
#
# Leave unset to run the app in demo mode: browsing and the species
# database work normally, but sign-in is disabled and Scan falls back to
# a mock identification result.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
